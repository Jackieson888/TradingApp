<Window x:Class="TradingApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TradingApp"
        mc:Ignorable="d"
        Title="Trading Practice" Height="840" Width="1380" MinHeight="680" MinWidth="1100"
        Background="#0B0E13" Foreground="#D5DAE3">

    <!-- THEME. Everything visual is defined once here, like a CSS file.
         * Setting Foreground on the Window above makes every TextBlock inside inherit that text
           colour (it is an "inherited" property), so we don't repeat it.
         * A Style with an x:Key is applied by name:  Style="{StaticResource SectionHeader}"
         * A Style with NO key (the DataGrid, ListBox and RadioButton ones below) automatically
           applies to every control of that type in the window. -->
    <Window.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#12161C"/>
            <Setter Property="BorderBrush" Value="#232A35"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="DockPanel.Dock" Value="Top"/>
        </Style>
        <Style x:Key="SectionHelp" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#8A93A3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="DockPanel.Dock" Value="Top"/>
        </Style>
        <Style x:Key="GlossaryItem" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#D5DAE3"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#0F1217"/>
            <Setter Property="Foreground" Value="#D5DAE3"/>
            <Setter Property="BorderBrush" Value="#232A35"/>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="#D5DAE3"/>
        </Style>

        <!-- DataGrid is the fiddliest control to restyle. The pieces: the grid itself, the column
             headers, and the cells (so the selected row gets a readable highlight). -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#12161C"/>
            <Setter Property="Foreground" Value="#D5DAE3"/>
            <Setter Property="BorderBrush" Value="#232A35"/>
            <Setter Property="RowBackground" Value="#12161C"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#232A35"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1B212A"/>
                        <Setter Property="Foreground" Value="#8A93A3"/>
                        <Setter Property="BorderBrush" Value="#232A35"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1F3A5F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The Window can hold exactly ONE child, so that child is a Grid holding everything else. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>   <!-- watchlist + connection -->
            <ColumnDefinition Width="*"/>     <!-- chart + practice orders (takes leftover width) -->
            <ColumnDefinition Width="400"/>   <!-- order book + glossary -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>    <!-- practice-mode banner: as tall as its text -->
            <RowDefinition Height="*"/>       <!-- main area (takes leftover height) -->
            <RowDefinition Height="190"/>     <!-- practice orders log -->
        </Grid.RowDefinitions>

        <!-- ============ Banner: be honest about what this app is ============ -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#3A2F0B" BorderBrush="#7A6320"
                BorderThickness="0,0,0,1" Padding="12,6">
            <TextBlock TextWrapping="Wrap" Foreground="#F5E1A0">
                <Run FontWeight="Bold" Text="PRACTICE MODE."/>
                <!-- x:Name so code-behind can reword this when running on the simulated feed. -->
                <Run x:Name="BannerText" Text="The prices are real and live (from the Kraken crypto exchange), but this app never places real orders and no money is involved. It is for learning how a trading screen works. Nothing here is financial advice."/>
            </TextBlock>
        </Border>

        <!-- ============ 1. Watchlist (+ connection status at the bottom) ============ -->
        <!-- RowSpan="2": this panel is as tall as the main area AND the practice-orders row. -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource Panel}">
            <DockPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="Watchlist"/>
                <TextBlock Style="{StaticResource SectionHelp}"
                           Text="The markets you're keeping an eye on. Price is the current going rate in US dollars. Click a row to see its chart and order book."/>

                <!-- Items docked to the Bottom stack upward from the edge: the first one declared
                     is lowest. So this reads (bottom to top): developer stats, status, heading. -->
                <TextBlock x:Name="StatsText" DockPanel.Dock="Bottom" FontSize="11" Foreground="#6C7585"
                           TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Text="Starting..." TextWrapping="Wrap"
                           FontSize="12"/>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource SectionHeader}" Text="Connection" Margin="0,12,0,2"/>

                <!-- DataGrid builds one row per item in its ItemsSource (set in code-behind).
                     We declare the columns ourselves; each Binding is resolved against ONE ROW
                     object (a Quote). x:Name lets code-behind reach this as WatchlistGrid. -->
                <DataGrid x:Name="WatchlistGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          ToolTip="Each row is one market. BTC/USD means Bitcoin priced in US dollars.">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Market" Binding="{Binding Symbol}" Width="*"/>
                        <!-- G7 = up to 7 significant digits: 84547.7, 2.1234, 0.1234567 all display sensibly. -->
                        <DataGridTextColumn Header="Price (USD)" Binding="{Binding Price, StringFormat=G7}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ============ 2. Live price chart ============ -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Panel}">
            <DockPanel>
                <TextBlock x:Name="ChartTitle" Style="{StaticResource SectionHeader}" Text="Live Price Chart"/>
                <TextBlock Style="{StaticResource SectionHelp}"
                           Text="How the price has moved over the last few minutes. It is recorded live while this app is open, so it starts empty and fills in. The line is green when the price is above where the window started, red when below. Hover over the chart to read exact values."/>

                <!-- Controls row. WrapPanel lays children out left to right and wraps if too narrow. -->
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="Time range:" Foreground="#8A93A3" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <RadioButton x:Name="Range1" GroupName="Range" Content="1 min"/>
                    <RadioButton x:Name="Range2" GroupName="Range" Content="2 min" IsChecked="True"/>
                    <RadioButton x:Name="Range5" GroupName="Range" Content="5 min" Margin="0,0,28,0"/>
                    <TextBlock Text="Style:" Foreground="#8A93A3" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <RadioButton x:Name="ModeLine" GroupName="Mode" Content="Line" IsChecked="True"
                                 ToolTip="One continuous line through every price."/>
                    <RadioButton x:Name="ModeCandles" GroupName="Mode" Content="Candles"
                                 ToolTip="Each candle summarizes a slice of time: its body runs from the first price to the last, its wick from the lowest to the highest. Green = rose, red = fell."/>
                </WrapPanel>

                <!-- One line of live numbers above the chart. Runs are pieces of one TextBlock that
                     can be styled separately: code-behind colours the middle one green or red. -->
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontSize="13">
                    <Run x:Name="SummaryLast" FontWeight="Bold" FontSize="18" Text="--"/>
                    <Run Text="  "/>
                    <Run x:Name="SummaryChange" FontWeight="SemiBold" Text=""/>
                    <Run x:Name="SummaryHighLow" Foreground="#8A93A3" Text=""/>
                </TextBlock>

                <!-- Our own control from PriceChartControl.cs. It draws itself. -->
                <local:PriceChartControl x:Name="Chart"/>
            </DockPanel>
        </Border>

        <!-- ============ 3. Order book (the ladder) + glossary ============ -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Style="{StaticResource Panel}">
            <!-- DockPanel, not StackPanel: a StackPanel gives each child only the height it asks
                 for, and LadderControl asks for none, so it would collapse to nothing. DockPanel
                 pins things to the edges; the LAST child fills the remaining space. -->
            <DockPanel>
                <!-- Text is filled in from code-behind with the selected market's name. -->
                <TextBlock x:Name="LadderTitle" Style="{StaticResource SectionHeader}" Text="Order Book"/>
                <TextBlock Style="{StaticResource SectionHelp}">
                    <Run Text="Everyone who is waiting to trade, sorted by price."/>
                    <Run Foreground="#5B9BF0" FontWeight="Bold" Text="Blue (left) = buyers"/>
                    <Run Text="and how much they want to buy."/>
                    <Run Foreground="#F0716F" FontWeight="Bold" Text="Red (right) = sellers"/>
                    <Run Text="and how much they're offering. Longer bar = more waiting at that price. The gold prices are the best offers on each side. Click blue at a price to practice a BUY, or red to practice a SELL."/>
                </TextBlock>

                <!-- A plain-language summary of the best prices right now (set from code-behind). -->
                <TextBlock x:Name="LadderSummary" DockPanel.Dock="Top" FontWeight="SemiBold" FontSize="12"
                           TextWrapping="Wrap" Margin="0,0,0,6" Text="Waiting for prices..."/>

                <!-- The glossary lives in an Expander (a collapsible section), docked to the bottom.
                     It is declared BEFORE the ladder so it claims its space first. -->
                <Expander DockPanel.Dock="Bottom" Header="What do these words mean?" Margin="0,8,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="230" Margin="0,6,0,0">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource GlossaryItem}">
                                <Run FontWeight="Bold" Text="Market."/>
                                <Run Text="Something you can trade, written as COIN/CURRENCY. BTC/USD is Bitcoin priced in US dollars."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource GlossaryItem}">
                                <Run FontWeight="Bold" Text="Bid."/>
                                <Run Text="The highest price any buyer is currently willing to pay. If you want to SELL right now, this is roughly what you'd get."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource GlossaryItem}">
                                <Run FontWeight="Bold" Text="Ask."/>
                                <Run Text="The lowest price any seller is currently willing to accept. If you want to BUY right now, this is roughly what you'd pay."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource GlossaryItem}">
                                <Run FontWeight="Bold" Text="Spread."/>
                                <Run Text="The gap between the best ask and the best bid. It's a built-in cost: buy and instantly sell again and you lose about the spread. Smaller is better."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource GlossaryItem}">
                                <Run FontWeight="Bold" Text="Price (watchlist and chart)."/>
                                <Run Text="The midpoint between the best bid and best ask: a fair estimate of the current price."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource GlossaryItem}">
                                <Run FontWeight="Bold" Text="Candle."/>
                                <Run Text="One slice of time summarized as a box and a line: the box runs from the first price to the last price in that slice, the line from the lowest to the highest."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource GlossaryItem}">
                                <Run FontWeight="Bold" Text="Size."/>
                                <Run Text="How much is waiting at a price, counted in coins (for BTC/USD, in bitcoin). Big size means lots of people at that price."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource GlossaryItem}">
                                <Run FontWeight="Bold" Text="Order book."/>
                                <Run Text="The full list of waiting buyers and sellers. Prices move when the best bid or ask is used up or a new one appears."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource GlossaryItem}">
                                <Run FontWeight="Bold" Text="Tick."/>
                                <Run Text="The smallest price step a market allows. Each row of the order book is one tick."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource GlossaryItem}">
                                <Run FontWeight="Bold" Text="Why do numbers flicker?"/>
                                <Run Text="Hundreds of changes arrive every second. The screen refreshes about 60 times a second and always shows the very latest."/>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </Expander>

                <!-- Column headings. This Grid's columns are 3 : 4 : 3, which matches the ladder's
                     30% / 40% / 30% split, so each heading sits over its column. -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="BUYERS (bids)" Foreground="#5B9BF0" FontWeight="Bold" FontSize="12"
                               HorizontalAlignment="Center" ToolTip="A bid is the price a buyer is willing to pay. The number is how much they want to buy."/>
                    <TextBlock Grid.Column="1" Text="PRICE (USD)" FontWeight="Bold" FontSize="12"
                               HorizontalAlignment="Center" ToolTip="Each row is one price step. Higher prices are at the top."/>
                    <TextBlock Grid.Column="2" Text="SELLERS (asks)" Foreground="#F0716F" FontWeight="Bold" FontSize="12"
                               HorizontalAlignment="Center" ToolTip="An ask is the price a seller wants. The number is how much they are offering."/>
                </Grid>

                <!-- Step 7: our own control from LadderControl.cs. The "local:" prefix is the
                     xmlns:local namespace declared at the top, so local:LadderControl means the
                     class TradingApp.LadderControl. It draws itself; MainWindow feeds it books. -->
                <local:LadderControl x:Name="Ladder"
                                     ToolTip="Click the blue side to practice a BUY at that price, or the red side to practice a SELL. Nothing real is ordered."/>
            </DockPanel>
        </Border>

        <!-- ============ 4. Practice orders (the blotter) ============ -->
        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Panel}">
            <DockPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="Practice Orders"/>
                <TextBlock Style="{StaticResource SectionHelp}"
                           Text="A log of the practice orders you've clicked on the order book. They are NOT sent anywhere. Each line shows the time, BUY or SELL, how many coins, which market, and the price you clicked."/>
                <!-- Consolas is a fixed-width font, so these headings line up with the log lines
                     below (see OnLadderClicked in MainWindow.xaml.cs, which pads the columns). -->
                <TextBlock DockPanel.Dock="Top" FontFamily="Consolas" FontWeight="Bold" Margin="4,0,0,2"
                           Foreground="#8A93A3"
                           Text="Time      Side  Qty  Market     Price (USD)"/>
                <ListBox x:Name="BlotterList" FontFamily="Consolas"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
